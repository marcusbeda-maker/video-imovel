{
  "name": "video-imovel-template",
  "private": true,
  "scripts": {
    "reels": "remotion render src/index.ts Reels saida-reels.mp4 --codec h264 --crf 17",
    "feed": "remotion render src/index.ts Feed saida-feed.mp4 --codec h264 --crf 17",
    "youtube": "remotion render src/index.ts YouTube saida-youtube.mp4 --codec h264 --crf 17",
    "checar": "tsc --noEmit -p .",
    "teste:video": "remotion render teste/index.tsx VideoTeste public/footage.mp4",
    "teste:video:quadrado": "remotion render teste/index.tsx VideoTesteQuadrado public/footage.mp4",
    "teste:video:horizontal": "remotion render teste/index.tsx VideoTesteHorizontal public/footage.mp4",
    "teste:imagem": "remotion still teste/index.tsx VideoTeste teste.png --frame=90"
  },
  "dependencies": {
    "@remotion/cli": "4.0.242",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.242"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
